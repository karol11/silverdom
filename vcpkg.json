{
  "name": "silverdom",
  "version": "0.0.10",
  "dependencies": [
    "sdl2",
    "opengl",
    {
      "name": "llvm",
      "default-features": false,
      "features": [ "target-x86", "target-aarch64" ]
    },
    {
      "name": "skia",
      "default-features": false,
      "features": [ "gl", "graphite", "freetype", "fontconfig", "harfbuzz", "icu" ]
    }
  ]
}
